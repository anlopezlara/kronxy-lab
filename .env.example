KRONXY_DB_NAME=kronxy
KRONXY_DB_USER=kronxy_app
KRONXY_DB_PASSWORD=
KRONXY_DB_PORT=5432

# KRONXY Execution Plane
ExecutionPlane__RepositoryRoot=
ExecutionPlane__WorkspaceRoot=
ExecutionPlane__DotnetExecutable=
ExecutionPlane__DotnetTarget=Kronxy.sln
ExecutionPlane__GitExecutable=

# KRONXY AI Gateway
AI__Provider=Ollama
AI__Endpoint=http://127.0.0.1:11434
AI__Models__CodingFast=NOT_CONFIGURED
AI__Models__CodingQuality=NOT_CONFIGURED
AI__Models__General=NOT_CONFIGURED
AI__MaxConcurrentInferences=1
AI__ConnectionTimeout=00:00:05
AI__InferenceTimeout=00:02:00
AI__QueueWaitTimeout=00:00:05
AI__MaxOutputTokens=2048
AI__MaxInputCharacters=65536
AI__MaxResponseBytes=1048576
