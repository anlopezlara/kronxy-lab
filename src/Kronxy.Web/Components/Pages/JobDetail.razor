@page "/jobs/{JobId:guid}"
@implements IDisposable
@inject IKronxyApiClient Api

<PageTitle>Job · KRONXY</PageTitle>

@if (_loading && _job is null) { <div class="loading">Loading Job…</div> }
else if (_error is not null && _job is null) { <ApiError Error="_error" Retry="LoadAsync" /> }
else if (_job is not null)
{
    <div class="page-heading">
        <div><a class="back" href="/jobs">← Jobs</a><p class="eyebrow">Job detail</p><h1>@_job.ExternalId</h1><div class="heading-meta"><StatusBadge Value="@_job.State" /><strong>Attempt @_job.AttemptCount</strong><span>Run <span class="mono">@_job.RunId</span></span>@if (_job.HumanReviewRequired) { <span class="badge warning">Human decision required</span> }</div></div>
        <div class="heading-actions"><label class="compact-field">Auto refresh<select value="@_pollSeconds" @onchange="PollingChanged"><option value="0">Off</option><option value="5">5 sec</option><option value="10">10 sec</option><option value="30">30 sec</option></select></label><button class="button secondary" disabled="@(_loading || _submitting)" @onclick="LoadAsync">Refresh</button></div>
    </div>

    @if (_error is not null) { <ApiError Error="_error" Retry="LoadAsync" /> }
    @if (_operationMessage is not null) { <div class="alert success" role="status"><strong>@_operationName</strong><span>@_operationMessage</span><span>Current state: @_job.State</span></div> }
    @if (_job.LastErrorCode is not null) { <div class="alert error"><strong>@_job.LastErrorCode</strong><span>@_job.LastErrorMessage</span></div> }

    <nav class="tabs">@foreach (string tab in Tabs) { <button class="@(_tab == tab ? "active" : "")" @onclick="() => _tab = tab">@tab</button> }</nav>

    @if (_tab == "Overview")
    {
        <section class="panel definition-grid"><Info Label="Job ID" Value="@_job.Id.ToString()" /><Info Label="External ID" Value="@_job.ExternalId" /><Info Label="Run ID" Value="@_job.RunId.ToString()" /><Info Label="State" Value="@OperatorPresentation.StateLabel(_job.State)" /><Info Label="Attempt" Value="@_job.AttemptCount.ToString()" /><Info Label="Human review" Value="@(_job.HumanReviewRequired ? "Required" : "No")" /><Info Label="Resume state" Value="@(_job.ResumeState ?? "—")" /><Info Label="Version" Value="@_job.Version.ToString()" /><Info Label="Created" Value="@_job.CreatedOnUtc.ToLocalTime().ToString("g")" /><Info Label="Updated" Value="@_job.UpdatedOnUtc.ToLocalTime().ToString("g")" /><Info Label="Completed" Value="@(_job.CompletedOnUtc?.ToLocalTime().ToString("g") ?? "—")" /></section>
        <section class="panel"><h2>Pipeline</h2><PipelineIndicator State="@_job.State" /></section>
    }
    else if (_tab == "Pipeline")
    {
        <section class="panel"><h2>Governed history</h2>@if (_history.Count == 0) { <div class="empty-state">No transition history available.</div> } else { <div class="timeline">@foreach (JobHistoryDto item in _history.OrderBy(item => item.Sequence)) { <article><span class="timeline-dot"></span><div><strong>@OperatorPresentation.StateLabel(item.FromState) → @OperatorPresentation.StateLabel(item.ToState)</strong><time>@item.Timestamp.ToLocalTime().ToString("g")</time><p>@item.Reason</p><small>@item.Actor · @item.CorrelationId</small></div></article> }</div> }</section>
    }
    else if (_tab == "Artifacts")
    {
        <section class="panel"><h2>Artifacts</h2>@if (_artifacts.Count == 0) { <div class="empty-state">No artifacts available.</div> } else { <div class="artifact-grid">@foreach (ArtifactDto item in _artifacts) { <button class="artifact-card" @onclick="() => OpenArtifactAsync(item)"><strong>@item.ArtifactType</strong><span class="mono">@item.ArtifactId</span><small>@FormatBytes(item.SizeBytes) · @item.CreatedAtUtc.ToLocalTime().ToString("g")</small><small>SHA256 @item.Sha256[..Math.Min(12, item.Sha256.Length)]…</small><small>Correlation @item.CorrelationId</small></button> }</div> }</section>
        @if (_artifactContent is not null) { <section class="panel artifact-view"><div class="panel-heading"><h2>@_selectedArtifact?.ArtifactType</h2><button class="button secondary" @onclick="() => _artifactContent = null">Close</button></div>@if (_artifactContent.IsText) { <pre>@OperatorPresentation.SafeArtifactText(_artifactContent)</pre> } else { <p>Binary artifact · @FormatBytes(_artifactContent.Content.Length)</p><a class="button" href="@BinaryDataUrl(_artifactContent)" download="@ArtifactFileName(_artifactContent)" target="_blank" rel="noopener">Download / open</a> }</section> }
    }
    else if (_tab == "Lineage")
    {
        @if (_lineage is null) { <div class="empty-state"><h2>No effective lineage available</h2><p>The API reported unavailable or ambiguous evidence.</p></div> } else { <section class="panel definition-grid"><Info Label="Lineage type" Value="@_lineage.LineageType" /><Info Label="Correlation ID" Value="@_lineage.CorrelationId" /><Info Label="Run ID" Value="@_lineage.RunId.ToString()" /><Info Label="Attempt" Value="@_lineage.AttemptCount.ToString()" /><Info Label="Source mutation" Value="@YesNo(_lineage.SourceMutationPresent)" /><Info Label="Observed changes" Value="@YesNo(_lineage.ObservedChangesAvailable)" /><Info Label="Build" Value="@(_lineage.BuildStatus ?? "Unavailable")" /><Info Label="Tests" Value="@(_lineage.TestStatus ?? "Unavailable")" /><Info Label="Reviewer" Value="@(_lineage.ReviewerStatus ?? "Unavailable")" /></section> }
    }
    else if (_tab == "Actions")
    {
        <section class="panel"><div class="panel-heading"><div><h2>Governed actions</h2><p class="hint">Availability is reported by KRONXY API. Every operation requires confirmation.</p></div></div>
            @if (_actions.Count == 0) { <div class="empty-state">The server returned no actions.</div> }
            else { <div class="action-grid">@foreach (AllowedActionDto action in _actions) { <button class="button action" disabled="@(!action.Allowed || _submitting)" title="@action.ReasonCode" @onclick="() => SelectAction(action)">@OperatorPresentation.ActionLabel(action.Action)</button> }</div> }
            @foreach (AllowedActionDto denied in _actions.Where(action => !action.Allowed)) { <small class="action-reason"><strong>@OperatorPresentation.ActionLabel(denied.Action):</strong> @(denied.ReasonCode ?? "Unavailable")</small> }
        </section>

        @if (_pendingAction is not null)
        {
            <section class="panel action-dialog" role="dialog" aria-modal="true"><h2>Confirm @OperatorPresentation.ActionLabel(_pendingAction)</h2><p>Job <strong>@_job.ExternalId</strong> is currently <strong>@OperatorPresentation.StateLabel(_job.State)</strong>.</p>
                @if (_pendingAction is "resume" or "retryPending") { <label>Reason<textarea @bind="_reason" rows="3" disabled="@_submitting"></textarea></label> }
                else if (_pendingAction == "humanReviewChangesRequired") { <label>Relative path<input @bind="_correctionPath" placeholder="src/…" disabled="@_submitting" /></label><label>Required correction<textarea @bind="_correctionInstruction" rows="4" disabled="@_submitting"></textarea></label> }
                else if (_pendingAction == "architectureDecision") { <label>Decision<select @bind="_architectureDecision" disabled="@_submitting"><option value="0">Preserve existing architecture</option><option value="2">Supersede request</option><option value="3">No code change required</option></select></label><label>Reason<textarea @bind="_reason" rows="4" disabled="@_submitting"></textarea></label><label class="check"><input type="checkbox" @bind="_followUpRequired" disabled="@_submitting" /> Follow-up required</label>@if (_followUpRequired) { <label>Follow-up description<textarea @bind="_followUpDescription" rows="3" disabled="@_submitting"></textarea></label> } }
                else if (_pendingAction == "humanCorrection") { <div class="alert warning"><strong>Additional source context required</strong><span>The public API does not expose current authorized content and SHA256 values needed for a safe editor. This action cannot be executed here.</span></div> }
                @if (_validationMessage is not null) { <div class="alert error">@_validationMessage</div> }
                <div class="dialog-actions"><button class="button secondary" disabled="@_submitting" @onclick="CloseAction">Back</button>@if (_pendingAction != "humanCorrection") { <button class="button" disabled="@_submitting" @onclick="ExecuteActionAsync">@(_submitting ? "Executing…" : "Confirm and execute")</button> }</div>
            </section>
        }
    }
}

@code {
    [Parameter] public Guid JobId { get; set; }
    private static readonly string[] Tabs = ["Overview", "Pipeline", "Artifacts", "Lineage", "Actions"];
    private string _tab = "Overview"; private bool _loading; private readonly OperatorActionGuard _submission = new(); private bool _submitting => _submission.IsActive; private int _pollSeconds;
    private JobDetailDto? _job; private IReadOnlyList<JobHistoryDto> _history = []; private IReadOnlyList<ArtifactDto> _artifacts = []; private LineageDto? _lineage; private IReadOnlyList<AllowedActionDto> _actions = [];
    private ArtifactDto? _selectedArtifact; private ArtifactContentDto? _artifactContent; private KronxyApiException? _error; private Timer? _pollTimer;
    private string? _pendingAction; private string _reason = string.Empty; private string _correctionPath = string.Empty; private string _correctionInstruction = string.Empty; private int _architectureDecision; private bool _followUpRequired; private string? _followUpDescription; private string? _validationMessage; private string? _operationName; private string? _operationMessage;

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_loading) return; _loading = true; _error = null;
        try { Task<JobDetailDto> job = Api.GetJobAsync(JobId); Task<IReadOnlyList<JobHistoryDto>> history = Api.GetJobHistoryAsync(JobId); Task<IReadOnlyList<ArtifactDto>> artifacts = Api.GetJobArtifactsAsync(JobId); Task<LineageDto?> lineage = Api.GetEffectiveLineageAsync(JobId); Task<IReadOnlyList<AllowedActionDto>> actions = Api.GetAllowedActionsAsync(JobId); await Task.WhenAll(job, history, artifacts, lineage, actions); _job = job.Result; _history = history.Result; _artifacts = artifacts.Result; _lineage = lineage.Result; _actions = actions.Result; }
        catch (KronxyApiException exception) { _error = exception; }
        finally { _loading = false; }
    }

    private void SelectAction(AllowedActionDto action) { if (!action.Allowed || _submitting) return; _pendingAction = action.Action; _validationMessage = null; _operationMessage = null; }
    private void CloseAction() { if (!_submitting) _pendingAction = null; }

    private async Task ExecuteActionAsync()
    {
        if (_pendingAction is null) return;
        _validationMessage = ValidateAction(); if (_validationMessage is not null || !_submission.TryBegin()) return;
        string action = _pendingAction; _error = null;
        try
        {
            OperationResultDto result = action switch
            {
                "advance" => await Api.AdvanceJobAsync(JobId),
                "resume" => await Api.ResumeJobAsync(JobId, _reason.Trim()),
                "retryPending" => await Api.RetryPendingAsync(JobId, _reason.Trim()),
                "cancel" => await Api.CancelJobAsync(JobId),
                "humanReviewApprove" => await Api.ApproveHumanReviewAsync(JobId),
                "humanReviewChangesRequired" => await Api.RequestHumanReviewChangesAsync(JobId, [new(_correctionPath.Trim(), _correctionInstruction.Trim())]),
                "architectureDecision" => await Api.ResolveArchitectureDecisionAsync(JobId, new((ArchitectureDecisionDto)_architectureDecision, _reason.Trim(), _followUpRequired, _followUpDescription?.Trim())),
                "reviewerHumanReviewCorrectionSupersede" => await Api.SupersedeReviewerCorrectionAsync(JobId),
                _ => throw new InvalidOperationException("Unsupported action.")
            };
            _operationName = OperatorPresentation.ActionLabel(action); _operationMessage = $"API result: {result.Kind}."; _pendingAction = null; _reason = string.Empty; await LoadAfterMutationAsync();
        }
        catch (KronxyApiException exception) { _error = exception; }
        finally { _submission.Complete(); }
    }

    private string? ValidateAction() => _pendingAction switch
    {
        "resume" or "retryPending" when string.IsNullOrWhiteSpace(_reason) => "Reason is required.",
        "humanReviewChangesRequired" when string.IsNullOrWhiteSpace(_correctionPath) || string.IsNullOrWhiteSpace(_correctionInstruction) => "Relative path and correction instruction are required.",
        "architectureDecision" when string.IsNullOrWhiteSpace(_reason) => "Reason is required.",
        "architectureDecision" when _followUpRequired && string.IsNullOrWhiteSpace(_followUpDescription) => "Follow-up description is required.",
        _ => null
    };

    private async Task LoadAfterMutationAsync() { _loading = false; await LoadAsync(); }
    private async Task OpenArtifactAsync(ArtifactDto item) { _selectedArtifact = item; try { _artifactContent = await Api.GetArtifactAsync(JobId, item.ArtifactId); } catch (KronxyApiException exception) { _error = exception; } }
    private void PollingChanged(ChangeEventArgs args) { _pollSeconds = int.TryParse(args.Value?.ToString(), out int value) ? value : 0; _pollTimer?.Dispose(); _pollTimer = _pollSeconds == 0 ? null : new Timer(async _ => await InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(_pollSeconds), TimeSpan.FromSeconds(_pollSeconds)); }
    private async Task PollAsync() { if (!_submitting && _pendingAction is null) { await LoadAsync(); StateHasChanged(); } }
    public void Dispose() => _pollTimer?.Dispose();
    private static string BinaryDataUrl(ArtifactContentDto content) => $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}";
    private static string ArtifactFileName(ArtifactContentDto content) => string.IsNullOrWhiteSpace(content.FileName) ? "artifact.bin" : content.FileName;
    private static string YesNo(bool value) => value ? "Yes" : "No";
    private static string FormatBytes(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024d:F1} KB";
}
