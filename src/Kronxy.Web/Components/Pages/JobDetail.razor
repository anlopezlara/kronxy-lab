@page "/jobs/{JobId:guid}"
@inject IKronxyApiClient Api
<PageTitle>Job · KRONXY</PageTitle>
@if (_loading){<div class="loading">Loading Job…</div>}
else if(_error is not null){<ApiError Error="_error" Retry="LoadAsync" />}
else if(_job is not null){
<div class="page-heading"><div><a class="back" href="/jobs">← Jobs</a><p class="eyebrow">Job detail</p><h1>@_job.ExternalId</h1><div class="heading-meta"><StatusBadge Value="@_job.State" /><span class="mono">@_job.Id</span></div></div><button class="button" @onclick="LoadAsync">Refresh</button></div>
<nav class="tabs">@foreach(var tab in Tabs){<button class="@(_tab==tab?"active":"")" @onclick="()=>_tab=tab">@tab</button>}</nav>
@if(_tab=="Overview"){
<section class="panel definition-grid"><Info Label="Job ID" Value="@_job.Id.ToString()" /><Info Label="Run ID" Value="@_job.RunId.ToString()" /><Info Label="State" Value="@_job.State" /><Info Label="Attempt" Value="@_job.AttemptCount.ToString()" /><Info Label="Human review" Value="@(_job.HumanReviewRequired?"Required":"No")" /><Info Label="Resume state" Value="@(_job.ResumeState??"—")" /><Info Label="Version" Value="@_job.Version.ToString()" /><Info Label="Created" Value="@_job.CreatedOnUtc.ToLocalTime().ToString("g")" /><Info Label="Updated" Value="@_job.UpdatedOnUtc.ToLocalTime().ToString("g")" /><Info Label="Completed" Value="@(_job.CompletedOnUtc?.ToLocalTime().ToString("g")??"—")" /></section>
@if(_job.LastErrorCode is not null){<div class="alert error"><strong>@_job.LastErrorCode</strong><span>@_job.LastErrorMessage</span></div>}
<section class="panel"><h2>Pipeline</h2><PipelineIndicator State="@_job.State" /></section>}
else if(_tab=="Pipeline"){
<section class="panel"><h2>Governed history</h2>@if(_history.Count==0){<div class="empty-state">No transition history available.</div>}else{<div class="timeline">@foreach(var item in _history.OrderBy(x=>x.Sequence)){<article><span class="timeline-dot"></span><div><strong>@item.FromState → @item.ToState</strong><time>@item.Timestamp.ToLocalTime().ToString("g")</time><p>@item.Reason</p><small>@item.Actor · @item.CorrelationId</small></div></article>}</div>}</section>}
else if(_tab=="Artifacts"){
<section class="panel"><h2>Artifacts</h2>@if(_artifacts.Count==0){<div class="empty-state">No artifacts available.</div>}else{<div class="artifact-grid">@foreach(var item in _artifacts){<button class="artifact-card" @onclick="()=>OpenArtifactAsync(item)"><strong>@item.ArtifactType</strong><span class="mono">@item.ArtifactId</span><small>@FormatBytes(item.SizeBytes) · @item.CreatedAtUtc.ToLocalTime().ToString("g")</small><small>SHA256 @item.Sha256[..Math.Min(12,item.Sha256.Length)]…</small></button>}</div>}</section>
@if(_artifactContent is not null){<section class="panel artifact-view"><div class="panel-heading"><h2>@_selectedArtifact?.ArtifactType</h2><button class="button secondary" @onclick="()=>_artifactContent=null">Close</button></div>@if(_artifactContent.IsText){<pre>@OperatorPresentation.SafeArtifactText(_artifactContent)</pre>}else{<p>Binary artifact · @FormatBytes(_artifactContent.Content.Length)</p><p class="hint">Binary content was retrieved safely by opaque artifact identity.</p><a class="button" href="@BinaryDataUrl(_artifactContent)" download="@ArtifactFileName(_artifactContent)" target="_blank" rel="noopener">Download / open</a>}</section>}}
else if(_tab=="Lineage"){
@if(_lineage is null){<div class="empty-state"><h2>No effective lineage available</h2><p>The API reported unavailable or ambiguous evidence.</p></div>}else{<section class="panel definition-grid"><Info Label="Lineage type" Value="@_lineage.LineageType" /><Info Label="Correlation ID" Value="@_lineage.CorrelationId" /><Info Label="Run ID" Value="@_lineage.RunId.ToString()" /><Info Label="Attempt" Value="@_lineage.AttemptCount.ToString()" /><Info Label="Source mutation" Value="@YesNo(_lineage.SourceMutationPresent)" /><Info Label="Observed changes" Value="@YesNo(_lineage.ObservedChangesAvailable)" /><Info Label="Build" Value="@(_lineage.BuildStatus??"Unavailable")" /><Info Label="Tests" Value="@(_lineage.TestStatus??"Unavailable")" /><Info Label="Reviewer" Value="@(_lineage.ReviewerStatus??"Unavailable")" /></section>}}
else if(_tab=="Actions"){
<section class="panel"><h2>Allowed actions</h2><p class="hint">Action execution will be enabled in Frontend V2.</p>@{var visible=OperatorPresentation.VisibleActions(_actions);}@if(visible.Count==0){<div class="empty-state">No actions are currently allowed.</div>}else{<div class="action-grid">@foreach(var action in visible){<button class="button action" disabled>@OperatorPresentation.ActionLabel(action.Action)</button>}</div>}</section>}
}
@code {
    [Parameter] public Guid JobId{get;set;} private static readonly string[] Tabs=["Overview","Pipeline","Artifacts","Lineage","Actions"]; private string _tab="Overview"; private bool _loading; private JobDetailDto? _job; private IReadOnlyList<JobHistoryDto> _history=[]; private IReadOnlyList<ArtifactDto> _artifacts=[]; private LineageDto? _lineage; private IReadOnlyList<AllowedActionDto> _actions=[]; private ArtifactDto? _selectedArtifact; private ArtifactContentDto? _artifactContent; private KronxyApiException? _error;
    protected override Task OnParametersSetAsync()=>LoadAsync(); private async Task LoadAsync(){_loading=true;_error=null;try{var job=Api.GetJobAsync(JobId);var history=Api.GetJobHistoryAsync(JobId);var artifacts=Api.GetJobArtifactsAsync(JobId);var lineage=Api.GetEffectiveLineageAsync(JobId);var actions=Api.GetAllowedActionsAsync(JobId);await Task.WhenAll(job,history,artifacts,lineage,actions);_job=job.Result;_history=history.Result;_artifacts=artifacts.Result;_lineage=lineage.Result;_actions=actions.Result;}catch(KronxyApiException ex){_error=ex;}finally{_loading=false;}}
    private async Task OpenArtifactAsync(ArtifactDto item){_selectedArtifact=item;try{_artifactContent=await Api.GetArtifactAsync(JobId,item.ArtifactId);}catch(KronxyApiException ex){_error=ex;}} private static string BinaryDataUrl(ArtifactContentDto content)=>$"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}"; private static string ArtifactFileName(ArtifactContentDto content)=>string.IsNullOrWhiteSpace(content.FileName)?"artifact.bin":content.FileName; private static string YesNo(bool value)=>value?"Yes":"No"; private static string FormatBytes(long bytes)=>bytes<1024?$"{bytes} B":$"{bytes/1024d:F1} KB";
}
