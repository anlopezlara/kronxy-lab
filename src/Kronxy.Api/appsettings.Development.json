{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExecutionPlane": {
    "RepositoryRoot": "",
    "WorkspaceRoot": "",
    "DotnetExecutable": "",
    "GitExecutable": "",
    "DotnetTarget": "Kronxy.sln"
  },
  "DeveloperPolicy": {
    "MaxOperations": 4,
    "MaxCreatedFiles": 3,
    "MaxFileBytes": 262144,
    "MaxTotalChangeBytes": 1048576,
    "MaxProposalBytes": 2097152,
    "MaxPathDepth": 16,
    "MaxPathCharacters": 240,
    "MaxSummaryCharacters": 256,
    "MaxIntentCharacters": 256,
    "MaxMetadataItems": 4,
    "MaxMetadataItemCharacters": 256
  },
  "ArtifactStore": {
    "RootPath": "",
    "MaxArtifactBytes": 16777216
  },
  "AI": {
    "Provider": "Ollama",
    "Endpoint": "http://127.0.0.1:11434",
    "Models": {
      "CodingFast": "NOT_CONFIGURED",
      "CodingQuality": "NOT_CONFIGURED",
      "General": "NOT_CONFIGURED"
    },
    "MaxConcurrentInferences": 1,
    "ConnectionTimeout": "00:00:05",
    "InferenceTimeout": "00:02:00",
    "PlanningInferenceTimeout": "00:03:00",
    "DeveloperInferenceTimeout": "00:03:00",
    "QueueWaitTimeout": "00:00:05",
    "MaxOutputTokens": 2048,
    "ContextWindowTokens": 16384,
    "MaxInputCharacters": 65536,
    "PlanningContextCharacters": 12000,
    "DeveloperContextCharacters": 12000,
    "DeveloperFeedbackCharacters": 8192,
    "MaxResponseBytes": 1048576
  },
  "Context": {
    "MaxFilesPerPackage": 500
  }
}
