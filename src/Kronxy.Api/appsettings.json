{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExecutionPlane": {
    "RepositoryRoot": "",
    "WorkspaceRoot": "",
    "DotnetExecutable": "",
    "GitExecutable": "",
    "DotnetTarget": "Kronxy.sln"
  },
  "ArtifactStore": {
    "RootPath": "",
    "MaxArtifactBytes": 16777216
  },
  "AI": {
    "Provider": "Ollama",
    "Endpoint": "http://127.0.0.1:11434",
    "Models": {
      "CodingFast": "NOT_CONFIGURED",
      "CodingQuality": "NOT_CONFIGURED",
      "General": "NOT_CONFIGURED"
    },
    "MaxConcurrentInferences": 1,
    "ConnectionTimeout": "00:00:05",
    "InferenceTimeout": "00:02:00",
    "QueueWaitTimeout": "00:00:05",
    "MaxOutputTokens": 2048,
    "MaxInputCharacters": 65536,
    "MaxResponseBytes": 1048576
  },
  "Context": {
    "MaxFilesPerPackage": 100
  }
}
